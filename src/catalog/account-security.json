{
  "key": "account-security",
  "label": "계정 보안 (CloudTrail)",
  "shortLabel": "CloudTrail",
  "shortCode": "acct",
  "dimensionName": "",
  "idPlaceholder": "(선택) 계정 별칭",
  "idHint": "이름 라벨 (선택)",
  "metrics": [
    {
      "key": "console-signin-failures",
      "label": "콘솔 로그인 실패",
      "namespace": "CloudTrailMetrics",
      "metricName": "ConsoleSignInFailures",
      "statistic": "Sum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 3,
      "thresholdUnit": "count",
      "treatMissingData": "notBreaching",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["지표필터 필요"],
      "note": "콘솔 로그인 실패 횟수. 지표 필터가 선행되어야 합니다."
    },
    {
      "key": "root-login",
      "label": "루트 계정 사용",
      "namespace": "CloudTrailMetrics",
      "metricName": "RootAccountUsage",
      "statistic": "Sum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 1,
      "thresholdUnit": "count",
      "treatMissingData": "notBreaching",
      "severity": "critical",
      "defaultOn": false,
      "badges": ["지표필터 필요"],
      "note": "루트 계정 사용이 감지되면 알람. 계정 전역이라 디멘션이 없습니다. 사전에 CloudTrail → CloudWatch Logs 지표 필터로 이 지표를 만들어야 하며, 네임스페이스·지표 이름은 필터 설정에 맞추세요."
    },
    {
      "key": "unauthorized-api",
      "label": "미승인 API 호출",
      "namespace": "CloudTrailMetrics",
      "metricName": "UnauthorizedAPICalls",
      "statistic": "Sum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 1,
      "thresholdUnit": "count",
      "treatMissingData": "notBreaching",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["지표필터 필요"],
      "note": "AccessDenied/UnauthorizedOperation 호출 횟수. 지표 필터가 선행되어야 합니다."
    }
  ]
}
