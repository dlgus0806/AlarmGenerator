{
  "key": "rds-pg",
  "label": "RDS PostgreSQL (비 Aurora)",
  "shortCode": "pg",
  "dimensionName": "DBInstanceIdentifier",
  "idPlaceholder": "prd-billing-db",
  "idHint": "DB 인스턴스 식별자",
  "metrics": [
    {
      "key": "cpu-high",
      "label": "CPU 사용률 높음",
      "namespace": "AWS/RDS",
      "metricName": "CPUUtilization",
      "statistic": "Average",
      "unit": "Percent",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 80,
      "thresholdUnit": "percent",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["기본", "Lv1/2/3"],
      "levels": [
        { "level": "Lv1", "threshold": 70, "severity": "warning" },
        { "level": "Lv2", "threshold": 80, "severity": "warning" },
        { "level": "Lv3", "threshold": 90, "severity": "critical" }
      ]
    },
    {
      "key": "storage-low",
      "hidden": true,
      "label": "여유 스토리지 부족",
      "namespace": "AWS/RDS",
      "metricName": "FreeStorageSpace",
      "statistic": "Minimum",
      "unit": "Bytes",
      "period": 300,
      "evaluationPeriods": 2,
      "datapointsToAlarm": 2,
      "comparisonOperator": "LessThanOrEqualToThreshold",
      "threshold": 20,
      "thresholdUnit": "gib",
      "treatMissingData": "missing",
      "severity": "critical",
      "defaultOn": false,
      "badges": ["기본", "인스턴스 의존"],
      "note": "할당 스토리지의 15% 정도가 기준입니다. GiB로 입력하면 바이트로 변환됩니다."
    },
    {
      "key": "freeable-memory-low",
      "label": "가용 메모리 부족",
      "namespace": "AWS/RDS",
      "metricName": "FreeableMemory",
      "statistic": "Minimum",
      "unit": "Bytes",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 3,
      "comparisonOperator": "LessThanOrEqualToThreshold",
      "threshold": 2,
      "thresholdUnit": "gib",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["인스턴스 의존"],
      "note": "인스턴스 메모리의 10% 정도. 인스턴스 클래스를 모르면 끄는 편이 안전합니다."
    },
    {
      "key": "connections-high",
      "hidden": true,
      "label": "DB 커넥션 과다",
      "namespace": "AWS/RDS",
      "metricName": "DatabaseConnections",
      "statistic": "Maximum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 100,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["기본"],
      "note": "max_connections의 80% 정도로 맞추세요. 기본값 100은 임의 값입니다."
    },
    {
      "key": "read-latency-high",
      "hidden": true,
      "label": "읽기 지연 높음",
      "namespace": "AWS/RDS",
      "metricName": "ReadLatency",
      "statistic": "Average",
      "unit": "Seconds",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 0.05,
      "thresholdUnit": "seconds",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": []
    },
    {
      "key": "write-latency-high",
      "hidden": true,
      "label": "쓰기 지연 높음",
      "namespace": "AWS/RDS",
      "metricName": "WriteLatency",
      "statistic": "Average",
      "unit": "Seconds",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 0.05,
      "thresholdUnit": "seconds",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": []
    },
    {
      "key": "replica-lag",
      "hidden": true,
      "label": "읽기 복제본 지연",
      "namespace": "AWS/RDS",
      "metricName": "ReplicaLag",
      "statistic": "Maximum",
      "unit": "Seconds",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 30,
      "thresholdUnit": "seconds",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": [],
      "note": "단위가 초입니다. Aurora의 AuroraReplicaLag는 밀리초이므로 혼동하지 마세요."
    },
    {
      "key": "burst-balance-low",
      "hidden": true,
      "label": "gp2 버스트 잔량 부족",
      "namespace": "AWS/RDS",
      "metricName": "BurstBalance",
      "statistic": "Minimum",
      "unit": "Percent",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 3,
      "comparisonOperator": "LessThanOrEqualToThreshold",
      "threshold": 20,
      "thresholdUnit": "percent",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["gp2 전용"],
      "note": "gp3 볼륨에는 이 지표가 없습니다."
    },
    {
      "key": "disk-queue-depth",
      "hidden": true,
      "label": "디스크 큐 길이 높음",
      "namespace": "AWS/RDS",
      "metricName": "DiskQueueDepth",
      "statistic": "Average",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 20,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["인스턴스 의존"]
    }
  ]
}
