{
  "key": "aurora-pg",
  "label": "Aurora PostgreSQL (인스턴스 단위)",
  "shortCode": "aurora",
  "dimensionName": "DBInstanceIdentifier",
  "idPlaceholder": "prd-orders-aurora-instance-1",
  "idHint": "DB 인스턴스 식별자. 클러스터 이름이 아니라 인스턴스 이름입니다",
  "metrics": [
    {
      "key": "cpu-high",
      "label": "CPU 사용률 높음",
      "namespace": "AWS/RDS",
      "metricName": "CPUUtilization",
      "statistic": "Average",
      "unit": "Percent",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 80,
      "thresholdUnit": "percent",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["기본", "Lv1/2/3"],
      "levels": [
        { "level": "Lv1", "threshold": 70, "severity": "warning" },
        { "level": "Lv2", "threshold": 80, "severity": "warning" },
        { "level": "Lv3", "threshold": 90, "severity": "critical" }
      ]
    },
    {
      "key": "replica-lag",
      "hidden": true,
      "label": "Aurora 복제 지연",
      "namespace": "AWS/RDS",
      "metricName": "AuroraReplicaLag",
      "statistic": "Maximum",
      "unit": "Milliseconds",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 1000,
      "thresholdUnit": "milliseconds",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["기본"],
      "note": "단위가 밀리초입니다. 비 Aurora RDS의 ReplicaLag는 초 단위이므로 값을 그대로 옮기면 안 됩니다."
    },
    {
      "key": "connections-high",
      "hidden": true,
      "label": "DB 커넥션 과다",
      "namespace": "AWS/RDS",
      "metricName": "DatabaseConnections",
      "statistic": "Maximum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 400,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["기본"],
      "note": "파라미터 그룹의 max_connections의 80% 정도로 잡으세요. 기본값 400은 임의 값입니다."
    },
    {
      "key": "free-local-storage-low",
      "hidden": true,
      "label": "로컬 스토리지 부족",
      "namespace": "AWS/RDS",
      "metricName": "FreeLocalStorage",
      "statistic": "Minimum",
      "unit": "Bytes",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 3,
      "comparisonOperator": "LessThanOrEqualToThreshold",
      "threshold": 5,
      "thresholdUnit": "gib",
      "treatMissingData": "missing",
      "severity": "critical",
      "defaultOn": false,
      "badges": ["인스턴스 의존"],
      "note": "Aurora에는 FreeStorageSpace가 없습니다(볼륨 자동 확장). 임시 테이블·정렬에 쓰이는 로컬 스토리지를 봅니다. 적정 임계값은 인스턴스 클래스에 따라 다릅니다."
    },
    {
      "key": "freeable-memory-low",
      "label": "가용 메모리 부족",
      "namespace": "AWS/RDS",
      "metricName": "FreeableMemory",
      "statistic": "Minimum",
      "unit": "Bytes",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 3,
      "comparisonOperator": "LessThanOrEqualToThreshold",
      "threshold": 2,
      "thresholdUnit": "gib",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["인스턴스 의존"],
      "note": "인스턴스 메모리의 10% 정도가 기준입니다. 인스턴스 클래스를 모르면 이 알람은 끄는 편이 안전합니다."
    },
    {
      "key": "deadlocks",
      "hidden": true,
      "label": "데드락 발생",
      "namespace": "AWS/RDS",
      "metricName": "Deadlocks",
      "statistic": "Sum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 2,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 0,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": []
    },
    {
      "key": "db-load-high",
      "hidden": true,
      "label": "DB 부하 높음 (DBLoad)",
      "namespace": "AWS/RDS",
      "metricName": "DBLoad",
      "statistic": "Average",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 4,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["추가 설정 필요", "인스턴스 의존"],
      "note": "Performance Insights 활성화 필요. 임계값은 인스턴스의 vCPU 수로 맞추세요."
    }
  ]
}
