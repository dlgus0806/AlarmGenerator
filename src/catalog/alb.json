{
  "key": "alb",
  "label": "ALB (Application Load Balancer)",
  "shortCode": "alb",
  "dimensionName": "LoadBalancer",
  "idPlaceholder": "app/prd-front-alb/50dc6c495c0c9188",
  "idPattern": "^app/[^/]+/[0-9a-f]+$",
  "idHint": "LoadBalancer 디멘션 값 (ARN 아님). ARN 뒤쪽 app/이름/해시 부분",
  "metrics": [
    {
      "key": "elb-5xx",
      "label": "ELB 5xx 응답",
      "namespace": "AWS/ApplicationELB",
      "metricName": "HTTPCode_ELB_5XX_Count",
      "statistic": "Sum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 2,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 10,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "critical",
      "defaultOn": true,
      "badges": ["기본"],
      "note": "ALB 자체가 5xx를 반환한 경우. 타깃 문제와 구분된다."
    },
    {
      "key": "target-5xx",
      "label": "타깃 5xx 응답",
      "namespace": "AWS/ApplicationELB",
      "metricName": "HTTPCode_Target_5XX_Count",
      "statistic": "Sum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 2,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 20,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "critical",
      "defaultOn": true,
      "badges": ["기본"]
    },
    {
      "key": "latency-p99",
      "hidden": true,
      "label": "응답 시간 p99 높음",
      "namespace": "AWS/ApplicationELB",
      "metricName": "TargetResponseTime",
      "extendedStatistic": "p99",
      "unit": "Seconds",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 2,
      "thresholdUnit": "seconds",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["기본"]
    },
    {
      "key": "unhealthy-hosts",
      "hidden": true,
      "label": "비정상 타깃 존재",
      "namespace": "AWS/ApplicationELB",
      "metricName": "UnHealthyHostCount",
      "statistic": "Maximum",
      "unit": "Count",
      "period": 60,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 1,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "critical",
      "defaultOn": false,
      "badges": ["기본"],
      "extraDimensions": [
        {
          "name": "TargetGroup",
          "label": "TargetGroup 디멘션 값",
          "placeholder": "targetgroup/prd-web-tg/73e2d6bc24d8a067"
        }
      ]
    },
    {
      "key": "rejected-conn",
      "hidden": true,
      "label": "연결 거부 발생",
      "namespace": "AWS/ApplicationELB",
      "metricName": "RejectedConnectionCount",
      "statistic": "Sum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 2,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 0,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": [],
      "note": "ALB 동시 연결 한도 초과. 0을 넘기면 이미 요청이 버려지고 있다."
    },
    {
      "key": "target-conn-error",
      "hidden": true,
      "label": "타깃 연결 오류",
      "namespace": "AWS/ApplicationELB",
      "metricName": "TargetConnectionErrorCount",
      "statistic": "Sum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 2,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 10,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": []
    }
  ]
}
