{
  "key": "lambda",
  "label": "Lambda 함수",
  "shortLabel": "Lambda",
  "shortCode": "lambda",
  "dimensionName": "FunctionName",
  "idPlaceholder": "my-function",
  "idHint": "함수 이름 (FunctionName)",
  "metrics": [
    {
      "key": "errors",
      "label": "함수 오류",
      "namespace": "AWS/Lambda",
      "metricName": "Errors",
      "statistic": "Sum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 1,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "critical",
      "defaultOn": true,
      "badges": ["기본"],
      "note": "함수 실행 오류 건수입니다. 호출이 없으면 데이터가 없어 INSUFFICIENT_DATA일 수 있습니다."
    },
    {
      "key": "throttles",
      "label": "스로틀",
      "namespace": "AWS/Lambda",
      "metricName": "Throttles",
      "statistic": "Sum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 1,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["기본"],
      "note": "동시성 한도로 요청이 스로틀된 횟수입니다."
    },
    {
      "key": "duration-p99",
      "hidden": true,
      "label": "실행 시간 (p99)",
      "namespace": "AWS/Lambda",
      "metricName": "Duration",
      "extendedStatistic": "p99",
      "unit": "Milliseconds",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanThreshold",
      "threshold": 3000,
      "thresholdUnit": "raw",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["p99"],
      "note": "함수 실행 시간(p99, 밀리초). 타임아웃 설정에 근접하는지 확인하세요."
    },
    {
      "key": "concurrent",
      "hidden": true,
      "label": "동시 실행 수",
      "namespace": "AWS/Lambda",
      "metricName": "ConcurrentExecutions",
      "statistic": "Maximum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 900,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["동시성"],
      "note": "예약/계정 동시성 한도에 근접하는지 확인합니다."
    }
  ]
}
