{
  "key": "ec2",
  "label": "EC2 인스턴스",
  "shortLabel": "EC2",
  "shortCode": "ec2",
  "dimensionName": "InstanceId",
  "idPlaceholder": "i-0abc123def456789",
  "idPattern": "^i-[0-9a-f]{8,17}$",
  "idHint": "인스턴스 ID",
  "metrics": [
    {
      "key": "cpu-high",
      "label": "CPU 사용률 높음",
      "namespace": "AWS/EC2",
      "metricName": "CPUUtilization",
      "statistic": "Average",
      "unit": "Percent",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 80,
      "thresholdUnit": "percent",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["기본", "Lv1/2/3"],
      "levels": [
        { "level": "Lv1", "threshold": 70, "severity": "warning" },
        { "level": "Lv2", "threshold": 80, "severity": "warning" },
        { "level": "Lv3", "threshold": 90, "severity": "critical" }
      ],
      "note": "Amazon EC2에서 EC2 인스턴스 실행에 사용하는 물리적 CPU 시간의 비율입니다."
    },
    {
      "key": "status-check-instance",
      "hidden": true,
      "label": "인스턴스 상태 검사 실패",
      "namespace": "AWS/EC2",
      "metricName": "StatusCheckFailed_Instance",
      "statistic": "Maximum",
      "unit": "Count",
      "period": 60,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 1,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "critical",
      "defaultOn": false,
      "badges": ["기본"],
      "note": "인스턴스가 마지막으로 인스턴스 상태 확인을 통과했는지 여부를 보고합니다."
    },
    {
      "key": "status-check-system",
      "hidden": true,
      "label": "시스템 상태 검사 실패",
      "namespace": "AWS/EC2",
      "metricName": "StatusCheckFailed_System",
      "statistic": "Maximum",
      "unit": "Count",
      "period": 60,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 1,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "critical",
      "defaultOn": false,
      "badges": ["기본"],
      "note": "인스턴스가 마지막으로 모든 상태 확인을 통과했는지 여부를 보고합니다."
    },
    {
      "key": "cpu-credit-low",
      "hidden": true,
      "label": "CPU 크레딧 부족",
      "namespace": "AWS/EC2",
      "metricName": "CPUCreditBalance",
      "statistic": "Minimum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "LessThanOrEqualToThreshold",
      "threshold": 20,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["T 계열 전용"],
      "note": "T2/T3/T4g 인스턴스에만 존재합니다. 시작 이후 인스턴스가 누적한 획득 CPU 크레딧 수입니다."
    },
    {
      "key": "ebs-io-balance-low",
      "hidden": true,
      "label": "EBS IO 버스트 잔량 부족",
      "namespace": "AWS/EC2",
      "metricName": "EBSIOBalance%",
      "statistic": "Minimum",
      "unit": "Percent",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "LessThanOrEqualToThreshold",
      "threshold": 20,
      "thresholdUnit": "percent",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["Nitro 전용"],
      "note": "버스트 버킷에 남아 있는 I/O 크레딧의 비율에 대한 정보를 제공합니다."
    },
    {
      "key": "mem-high",
      "label": "메모리 사용률 높음",
      "namespace": "CWAgent",
      "metricName": "mem_used_percent",
      "statistic": "Average",
      "unit": "Percent",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 85,
      "thresholdUnit": "percent",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["에이전트 필요", "Lv1/2/3"],
      "levels": [
        { "level": "Lv1", "threshold": 70, "severity": "warning" },
        { "level": "Lv2", "threshold": 80, "severity": "warning" },
        { "level": "Lv3", "threshold": 90, "severity": "critical" }
      ],
      "note": "현재 사용 중인 메모리 비율입니다. 지표 확인을 위해서는 CloudWatch Agent 설치가 필요합니다."
    },
    {
      "key": "disk-high",
      "label": "디스크 사용률 높음",
      "namespace": "CWAgent",
      "metricName": "disk_used_percent",
      "statistic": "Average",
      "unit": "Percent",
      "period": 300,
      "evaluationPeriods": 1,
      "datapointsToAlarm": 1,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 85,
      "thresholdUnit": "percent",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["에이전트 필요", "Lv1/2/3"],
      "levels": [
        { "level": "Lv1", "threshold": 80, "severity": "warning" },
        { "level": "Lv2", "threshold": 85, "severity": "warning" },
        { "level": "Lv3", "threshold": 90, "severity": "critical" }
      ],
      "note": "사용된 총 디스크 공간 비율입니다. 에이전트 설정에 따라 device / fstype 디멘션이 추가로 필요할 수 있습니다.",
      "extraDimensions": [
        { "name": "path", "label": "마운트 경로", "placeholder": "/", "default": "/", "required": false }
      ]
    }
  ]
}
