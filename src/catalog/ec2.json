{
  "key": "ec2",
  "label": "EC2 인스턴스",
  "shortCode": "ec2",
  "dimensionName": "InstanceId",
  "idPlaceholder": "i-0abc123def456789",
  "idPattern": "^i-[0-9a-f]{8,17}$",
  "idHint": "인스턴스 ID",
  "metrics": [
    {
      "key": "cpu-high",
      "label": "CPU 사용률 높음",
      "namespace": "AWS/EC2",
      "metricName": "CPUUtilization",
      "statistic": "Average",
      "unit": "Percent",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 80,
      "thresholdUnit": "percent",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["기본", "Lv1/2/3"],
      "levels": [
        { "level": "Lv1", "threshold": 70, "severity": "warning" },
        { "level": "Lv2", "threshold": 80, "severity": "warning" },
        { "level": "Lv3", "threshold": 90, "severity": "critical" }
      ]
    },
    {
      "key": "status-check-instance",
      "hidden": true,
      "label": "인스턴스 상태 검사 실패",
      "namespace": "AWS/EC2",
      "metricName": "StatusCheckFailed_Instance",
      "statistic": "Maximum",
      "unit": "Count",
      "period": 60,
      "evaluationPeriods": 2,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 1,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "critical",
      "defaultOn": false,
      "badges": ["기본"],
      "note": "OS 레벨 문제. 재부팅으로 복구되는 경우가 많다. (결측=missing: 지표가 끊기면 상태 유지)"
    },
    {
      "key": "status-check-system",
      "hidden": true,
      "label": "시스템 상태 검사 실패",
      "namespace": "AWS/EC2",
      "metricName": "StatusCheckFailed_System",
      "statistic": "Maximum",
      "unit": "Count",
      "period": 60,
      "evaluationPeriods": 2,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 1,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "critical",
      "defaultOn": false,
      "badges": ["기본"],
      "note": "AWS 인프라 문제. 인스턴스 중지/시작으로 다른 호스트로 이동해야 복구된다. (결측=missing)"
    },
    {
      "key": "cpu-credit-low",
      "hidden": true,
      "label": "CPU 크레딧 부족",
      "namespace": "AWS/EC2",
      "metricName": "CPUCreditBalance",
      "statistic": "Minimum",
      "unit": "Count",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 3,
      "comparisonOperator": "LessThanOrEqualToThreshold",
      "threshold": 20,
      "thresholdUnit": "count",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["T 계열 전용"],
      "note": "T2/T3/T4g 인스턴스에만 존재한다. 다른 계열에 걸면 영구 INSUFFICIENT_DATA."
    },
    {
      "key": "ebs-io-balance-low",
      "hidden": true,
      "label": "EBS IO 버스트 잔량 부족",
      "namespace": "AWS/EC2",
      "metricName": "EBSIOBalance%",
      "statistic": "Minimum",
      "unit": "Percent",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 3,
      "comparisonOperator": "LessThanOrEqualToThreshold",
      "threshold": 20,
      "thresholdUnit": "percent",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": false,
      "badges": ["Nitro 전용"],
      "note": "Nitro 기반 인스턴스 + 버스트 볼륨에서만 나온다."
    },
    {
      "key": "mem-high",
      "label": "메모리 사용률 높음",
      "namespace": "CWAgent",
      "metricName": "mem_used_percent",
      "statistic": "Average",
      "unit": "Percent",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 2,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 85,
      "thresholdUnit": "percent",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["에이전트 필요"],
      "note": "CloudWatch Agent 설치 필요. 에이전트 설정에 따라 디멘션 구성이 달라질 수 있으니 list-metrics로 확인하세요."
    },
    {
      "key": "disk-high",
      "label": "디스크 사용률 높음",
      "namespace": "CWAgent",
      "metricName": "disk_used_percent",
      "statistic": "Average",
      "unit": "Percent",
      "period": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 3,
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "threshold": 85,
      "thresholdUnit": "percent",
      "treatMissingData": "missing",
      "severity": "warning",
      "defaultOn": true,
      "badges": ["에이전트 필요"],
      "note": "에이전트 설정에 따라 device / fstype 디멘션이 추가로 필요할 수 있습니다. list-metrics로 실제 디멘션을 확인하세요.",
      "extraDimensions": [
        { "name": "path", "label": "마운트 경로", "placeholder": "/" }
      ]
    }
  ]
}
